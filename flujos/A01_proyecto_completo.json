  {
    "id": "a01v2_cmd_fn",
    "type": "function",
    "z": "a01v2_tab",
    "name": "APLICAR COMANDO GLOBAL",
    "func": "// El HTML de /a01-v2 envía {command, value}.  Se conserva el motor original.\nconst req = (msg.payload && typeof msg.payload === 'object') ? msg.payload : {};\nconst cmd = String(req.command || '').trim();\nconst value = Number(req.value);\nconst validSpeed = req.value !== null && req.value !== undefined && req.value !== '' && Number.isFinite(value) && value >= 0 && value <= 1;\nconst state = String(global.get('state') || 'stopped');\nconst sensorFail = global.get('sensor_fail') === true;\nlet status = 200;\nlet error = '';\nswitch(cmd) {\n    case 'start':\n        if (sensorFail) { status = 409; error = 'Sensor con falla: primero pulsa Reparar Sensor'; break; }\n        if (state === 'jammed') { status = 409; error = 'Atasco activo: primero pulsa Desatascar'; break; }\n        if (req.value !== null && req.value !== undefined && !validSpeed) { status = 400; error = 'Consigna fuera de 0..1'; break; }\n        global.set('target_speed', validSpeed ? value : 0.5);\n        global.set('state', 'running');\n        break;\n    case 'stop':\n        global.set('state', 'stopped');\n        global.set('target_speed', 0);\n        global.set('speed', 0);\n        break;\n    case 'set_speed':\n        if (!validSpeed) { status = 400; error = 'Consigna fuera de 0..1'; break; }\n        global.set('target_speed', value);\n        break;\n    case 'trigger_jam':\n        global.set('state', 'jammed');\n        global.set('speed', 0);\n        break;\n    case 'clear_jam':\n        if (state === 'jammed') {\n            global.set('state', 'stopped');\n            global.set('target_speed', 0);\n            global.set('speed', 0);\n        }\n        break;\n    case 'sensor_fail':\n        global.set('sensor_fail', true);\n        global.set('state', 'stopped');\n        global.set('target_speed', 0);\n        global.set('speed', 0);\n        break;\n    case 'sensor_fix':\n        global.set('sensor_fail', false);\n        break;\n    default:\n        status = 400;\n        error = 'Comando desconocido: ' + cmd;\n}\nconst result = {ok: status === 200, version: 'a01-v2', command: cmd,\n    state: String(global.get('state') || 'stopped'), target_speed: Number(global.get('target_speed')) || 0};\nif (error) result.error = error;\nmsg.statusCode = status;\nmsg.headers = {'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store'};\nmsg.payload = result;\nnode.warn('A01 V2 POST ' + cmd + ' -> ' + result.state + ' (HTTP ' + status + ')');\nreturn msg;",
