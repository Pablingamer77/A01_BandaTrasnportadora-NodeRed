  {
    "id": "03f1fdfcd76f9a80",
    "type": "change",
    "z": "31e607b434bce90b",
    "name": "Ecuaciones Físicas (JSONata)",
    "rules": [
      {
        "t": "set",
        "p": "speed",
        "pt": "global",
        "to": "(\t    $s := $globalContext(\"speed\");\t    $t := $globalContext(\"target_speed\");\t    $st := $globalContext(\"state\");\t    $st = \"jammed\" ? 0 :\t    $st = \"running\" ? (\t        $s < $t ? $min([$s + 0.2, $t]) :\t        $s > $t ? $max([$s - 0.2, $t]) : $s\t    ) : $max([$s - 0.2, 0])\t)",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "current",
        "pt": "global",
        "to": "(\t    $s := $globalContext(\"speed\");\t    $st := $globalContext(\"state\");\t    $base := ($st = \"running\" or $s > 0) ? 2.0 : 0.0;\t    $carga := $s >= 1.0 ? 11.0 : $s * 3.5;\t    $atasco := ($st = \"jammed\") ? 15.0 : 0.0;\t    $base + $carga + $atasco\t)",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "temperature",
        "pt": "global",
        "to": "(\t    $t := $globalContext(\"temperature\");\t    $i := $globalContext(\"current\");\t    $calentamiento := $i > 5.0 ? ($i - 5.0) * 0.5 : 0;\t    $disipacion := 0.1 * ($t - 25.0);\t    $max([$t + $calentamiento - $disipacion, 25.0])\t)",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "products",
        "pt": "global",
        "to": "(\t    $p := $globalContext(\"products\");\t    $s := $globalContext(\"speed\");\t    $st := $globalContext(\"state\");\t    $fail := $globalContext(\"sensor_fail\");\t    $st = \"jammed\" or $fail = true ? $p : $p + ($s / 2.0)\t)",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "x": 580,
    "y": 320,
    "wires": [
      [
        "0de75ee79ca1a1bf",
        "c73f520ae48dbbef",
        "554591afb7750baf"
      ]
    ]
  },
