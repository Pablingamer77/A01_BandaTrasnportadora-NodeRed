    "func": "// Lee datos reales del motor original en Contexto Global.\nconst n = (key, fallback) => { const value = global.get(key); const num = Number(value); return value !== null && value !== undefined && Number.isFinite(num) ? num : fallback; };\nmsg.statusCode = 200;\nmsg.headers = {'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store'};\nmsg.payload = {ok: true, version: 'a01-v2', state: String(global.get('state') || 'stopped'),\n    speed: n('speed', 0), target_speed: n('target_speed',0),\n    current: n('current',0), temperature: n('temperature',25),\n    products: n('products',0), sensor_fail: global.get('sensor_fail') === true,\n    fecha: new Date().toISOString()};\nreturn msg;",
